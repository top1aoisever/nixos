# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "nvme" "xhci_pci" "usbhid" "uas" "sd_mod" "rtsx_pci_sdmmc" ];
  boot.initrd.kernelModules = [];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  boot.kernelParams = [
    # "amdgpu.dcdebugmask=0x10"
    # i headr this fixes random reboot issue
    # "processor.max_cstate=5"
    # "idle=nomwait"
    # "mce=off"
  ];

  boot.kernelPackages = pkgs.linuxPackages_7_2;

  fileSystems."/" =
    { device = "/dev/mapper/crypt";
      fsType = "btrfs";
      options = [ "subvol=@" ];
    };

  boot.initrd.luks.devices."crypt".device = "/dev/disk/by-uuid/dab1bde8-0f89-47d2-92a2-f20c7aca133f";

  fileSystems."/home" =
    { device = "/dev/mapper/crypt";
      fsType = "btrfs";
      options = [ "subvol=@home" ];
    };

  fileSystems."/var/log" =
    { device = "/dev/mapper/crypt";
      fsType = "btrfs";
      options = [ "subvol=@log" ];
    };

  fileSystems."/var/cache" =
    { device = "/dev/mapper/crypt";
      fsType = "btrfs";
      options = [ "subvol=@cache" ];
    };

  fileSystems."/nix" =
    { device = "/dev/mapper/crypt";
      fsType = "btrfs";
      options = [ "subvol=@nix" ];
    };

  fileSystems."/boot" =
    { device = "/dev/disk/by-uuid/816E-A509";
      fsType = "vfat";
      options = [ "fmask=0022" "dmask=0022" ];
    };

  swapDevices =
    [ { device = "/dev/disk/by-uuid/c632711c-ef2d-4db6-8bf2-f1d32b3e7fab"; }
    ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";

  hardware.cpu.amd.updateMicrocode = lib.mkForce true;

  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };

  hardware.nvidia = {
    open = true;

    modesetting.enable = true;

    powerManagement.enable = true;
    powerManagement.finegrained = false;

    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true;
      };

      nvidiaBusId = "PCI:1:0:0";
      amdgpuBusId = "PCI:6:0:0";
    };
  };

  services.xserver.videoDrivers = ["nvidia"];
}
